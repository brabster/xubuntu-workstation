#!/usr/bin/env bash
set -euo pipefail

changed_files=()
while IFS= read -r -d '' file; do
  if [[ "${file}" =~ ^(roles/.*\.ya?ml|workstation\.ya?ml|test\.ya?ml)$ ]]; then
    changed_files+=("${file}")
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMT -- roles workstation.yml workstation.yaml test.yml test.yaml)

if [ "${#changed_files[@]}" -eq 0 ]; then
  exit 0
fi

if ! command -v ansible-lint >/dev/null 2>&1; then
  echo "ansible-lint is required for local Ansible lint checks." >&2
  echo "Set up this repository with:" >&2
  echo "  git config core.hooksPath .githooks" >&2
  echo "  python3 -m pip install -r requirements-dev.txt" >&2
  exit 1
fi

echo "Running ansible-lint on staged Ansible files..."

unstaged_files=()
while IFS= read -r -d '' file; do
  unstaged_files+=("${file}")
done < <(git diff --name-only -z -- "${changed_files[@]}")

if [ "${#unstaged_files[@]}" -gt 0 ]; then
  echo "Unstaged changes detected in files being linted; stage or stash these first:" >&2
  printf '  %s\n' "${unstaged_files[@]}" >&2
  exit 1
fi

ansible-lint --offline "${changed_files[@]}"
