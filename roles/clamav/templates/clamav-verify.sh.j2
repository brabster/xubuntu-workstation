#!/usr/bin/env bash

set -euo pipefail

# --- Configuration ---
TARGET_USER="$1"
if [ -z "$TARGET_USER" ]; then
    echo "ERROR: Username must be provided as the first argument." >&2
    exit 1
fi

DOWNLOADS_DIR="${CLAMAV_DOWNLOADS_DIR:-/home/${TARGET_USER}/Downloads}"
QUARANTINE_DIR="${CLAMAV_QUARANTINE_DIR:-{{ clamav_quarantine_dir }}}"
CLAMAV_LOG_DIR="${CLAMAV_LOG_DIR:-/var/log/clamav}"

EICAR_STRING='X5O!P%@AP[4\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*'
TEST_FILE_NAME=".health-check-$(date +%s).txt"
TEST_FILE_PATH="${DOWNLOADS_DIR}/${TEST_FILE_NAME}"
QUARANTINED_FILE_PATH="${QUARANTINE_DIR}/${TEST_FILE_NAME}"

# --- Main Logic ---
echo "Verifying AV scanning is operational with test file ${TEST_FILE_NAME}..."

cleanup() {
  runuser -l "${TARGET_USER}" -c "rm -f '${TEST_FILE_PATH}'" &>/dev/null || true
  rm -f "${QUARANTINED_FILE_PATH}" &>/dev/null || true
}

print_log_tail() {
  case "$1" in
    *.gz)
      gzip -cd -- "$1" | tail -n 3
      ;;
    *)
      tail -n 3 -- "$1"
      ;;
  esac
}

log_has_nonblank_lines() {
  case "$1" in
    *.gz)
      set +o pipefail
      gzip -cd -- "$1" 2>/dev/null | grep -q '[^[:space:]]'
      pipe_status=("${PIPESTATUS[@]}")
      set -o pipefail
      gzip_status=${pipe_status[0]:-0}
      grep_status=${pipe_status[1]:-1}
      if [ "${gzip_status}" -ne 0 ] && [ "${gzip_status}" -ne 141 ]; then
        return 2
      fi
      return "${grep_status}"
      ;;
    *)
      grep -q '[^[:space:]]' "$1"
      ;;
  esac
}

echo_latest_updates() {
  echo " --- latest antivirus update log"

  if [ -f "${CLAMAV_LOG_DIR}/freshclam.log" ]; then
    if log_has_nonblank_lines "${CLAMAV_LOG_DIR}/freshclam.log"; then
      print_log_tail "${CLAMAV_LOG_DIR}/freshclam.log"
      return
    fi
  fi

  shopt -s nullglob
  rotated_log_paths=("${CLAMAV_LOG_DIR}"/freshclam.log.[0-9]*)
  shopt -u nullglob

  while IFS= read -r rotated_log_name; do
    [ -n "${rotated_log_name}" ] || continue
    rotated_log_path="${CLAMAV_LOG_DIR}/${rotated_log_name}"
    [ -f "${rotated_log_path}" ] || continue
    if log_has_nonblank_lines "${rotated_log_path}"; then
      print_log_tail "${rotated_log_path}"
      return
    else
      log_check_status=$?
      if [ "${log_check_status}" -eq 2 ]; then
        echo "WARNING: Could not read FreshClam log source ${rotated_log_path}" >&2
      fi
    fi
  done < <(
    # logrotate numbers the newest rotated log as .1, then older generations as .2, .3, etc.
    for rotated_log_path in "${rotated_log_paths[@]}"; do
      printf '%s\n' "${rotated_log_path##*/}"
    done |
      sed -nE '/^freshclam\.log\.[0-9]+(\.gz)?$/p' |
      sed -E 's/^freshclam\.log\.([0-9]+)(\.gz)?$/\1 &/' |
      sort -n |
      cut -d' ' -f2-
  )

  journal_lines="$(journalctl -u clamav-freshclam.service --no-pager -n 50 2>/dev/null | tail -n 3 || true)"
  if printf '%s' "${journal_lines}" | grep -q '[^[:space:]]'; then
    printf '%s\n' "${journal_lines}"
    return
  fi

  echo "No recent antivirus update log entries were found."
}

echo_latest_updates

trap cleanup EXIT

runuser -l "${TARGET_USER}" -c "echo '${EICAR_STRING}' > '${TEST_FILE_PATH}'"

POLL_TIMEOUT=15
SECONDS=0
while [ $SECONDS -lt $POLL_TIMEOUT ]; do
  if [ -f "${QUARANTINED_FILE_PATH}" ]; then
      echo "ClamAV on-access scanning is working correctly."
      exit 0
  fi
  sleep 1
done

# --- Failure Path with Diagnostics ---
echo "ERROR: ClamAV on-access test failed. Test file was not quarantined." >&2
echo "" >&2
echo "--- DIAGNOSTICS ---" >&2
echo "--- Running Processes:" >&2
ps aux | grep -E '[c]lamd|[c]lamonacc' || true
echo "" >&2
echo "--- clamav.log (last 30 lines):" >&2
tail -n 30 "${CLAMAV_LOG_DIR}/clamav.log" || true
echo "" >&2
echo "--- clamonacc.log (last 30 lines):" >&2
tail -n 30 "${CLAMAV_LOG_DIR}/clamonacc.log" || true
echo "-------------------" >&2
echo "--- quarantine_events.log (last 30 lines):" >&2
tail -n 30 "${CLAMAV_LOG_DIR}/quarantine_events.log" || true
echo "-------------------" >&2

exit 1
