#!/bin/sh

set -eu

service=xubuntu-workstation-update.service
last_success=/var/lib/xubuntu-workstation-update/last-success
log_file=/var/log/xubuntu-workstation-update.log
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/xubuntu-workstation-update"
notified_file="${cache_dir}/last-notification"
check_interval=900
stale_after=93600
reminder_interval=86400
monitor=true

if [ "${1:-}" = "--once" ]; then
    monitor=false
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] \
    || { [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; } \
    || ! command -v notify-send >/dev/null 2>&1; then
    exit 0
fi

notify_once() {
    signature=$1
    title=$2
    message=$3

    now="$(date +%s)"
    if [ -r "$notified_file" ]; then
        notified_signature="$(cut -d ' ' -f 1 "$notified_file")"
        notified_time="$(cut -d ' ' -f 2 "$notified_file")"
        if [ "$notified_signature" = "$signature" ] \
            && [ "$notified_time" -gt 0 ] \
            && [ $((now - notified_time)) -lt "$reminder_interval" ]; then
            return
        fi
    fi

    if notify-send --urgency=critical --expire-time=0 "$title" "$message"; then
        mkdir -p "$cache_dir"
        chmod 0700 "$cache_dir"
        printf '%s %s\n' "$signature" "$now" > "${notified_file}.tmp"
        mv -f "${notified_file}.tmp" "$notified_file"
        chmod 0600 "$notified_file"
    fi
}

while :; do
    if ! active_state="$(systemctl show --system --property=ActiveState --value "$service" 2>/dev/null)"; then
        notify_once "status-unavailable" \
            "Cannot check workstation updates" \
            "The update service status could not be read. Check systemctl status ${service} and ${log_file}."
        [ "$monitor" = true ] || exit 0
        sleep "$check_interval"
        continue
    fi

    case "$active_state" in
        active|activating|reloading)
            if [ -r "$notified_file" ] \
                && [ "$(cat "$notified_file")" = "status-unavailable" ]; then
                rm -f "$notified_file"
            fi
            ;;
        failed)
            result="$(systemctl show --system --property=Result --value "$service" 2>/dev/null || printf unknown)"
            exit_status="$(systemctl show --system --property=ExecMainStatus --value "$service" 2>/dev/null || printf unknown)"
            notify_once "failed:${result}:${exit_status}" \
                "Workstation updates failed" \
                "The update service failed. It will try again at the next hourly run. Check systemctl status ${service} and ${log_file}."
            ;;
        *)
            if [ -r "$last_success" ]; then
                last_success_time="$(cat "$last_success")"
                last_success_epoch="$(date --date="$last_success_time" +%s 2>/dev/null || printf 0)"
            else
                last_success_time=never
                last_success_epoch=0
            fi

            now="$(date +%s)"
            if [ "$last_success_epoch" -eq 0 ] || [ $((now - last_success_epoch)) -gt "$stale_after" ]; then
                notify_once "stale:${last_success_time}" \
                    "Workstation updates are overdue" \
                    "No successful update run has completed in the last 26 hours. Check systemctl status ${service} and ${log_file}."
            elif [ -e "$notified_file" ]; then
                rm -f "$notified_file"
            fi
            ;;
    esac

    [ "$monitor" = true ] || exit 0
    sleep "$check_interval"
done
