#!/bin/sh

set -eu

exec >> /var/log/xubuntu-workstation-update.log 2>&1

finish_update() {
    result=$?
    if [ "$result" -eq 0 ]; then
        printf '=== Update completed at %s ===\n' "$(date --iso-8601=seconds)"
    else
        printf '=== Update FAILED at %s (exit %s) ===\n' "$(date --iso-8601=seconds)" "$result"
    fi
    exit "$result"
}

trap finish_update EXIT

export DEBIAN_FRONTEND=noninteractive

printf '\n=== Update started at %s ===\n' "$(date --iso-8601=seconds)"
echo "Package updates"

apt-get update
apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold --with-new-pkgs upgrade
apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold autoremove

echo "Snap updates"

snap refresh

echo "Firmware updates"

if command -v fwupdmgr >/dev/null 2>&1; then
    fwupdmgr refresh --force
    fwupdmgr update --assume-yes
else
    echo "fwupdmgr is not installed; skipping firmware updates"
fi

echo "Running user updates"
timeout --signal=TERM --kill-after=30s 10m runuser --user '{{ username }}' -- '{{ user_update_script }}'
